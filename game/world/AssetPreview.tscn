[gd_scene load_steps=4 format=3]

; Asset preview and budget check. Not part of the game — run it directly:
;
;   $GODOT --path game res://world/AssetPreview.tscn
;
; Camera settings are the locked ones from docs/ART_BIBLE.md and match
; world/WorldRoot.tscn exactly. If they ever diverge, this preview stops being
; evidence about anything.
;
; Angles rather than a Transform3D basis, deliberately — see .agent/MEMORY.md,
; "Godot Transform3D literals fill ROWS, not columns".

[ext_resource type="Script" path="res://tools/asset_preview.gd" id="1_preview"]

[sub_resource type="Environment" id="Environment_preview"]
background_mode = 1
background_color = Color(0.11, 0.12, 0.13, 1)
ambient_light_source = 2
; Cool and dim, against a warm sun. This split is what gives a building a clearly
; lit side and a clearly shadowed one instead of an even grey wash — the thing
; that reads as "premium" in Clash of Clans and every game in the genre. It was
; 0.6 of a neutral grey, which lit the shadow side almost as brightly as the sun
; lit the front, and left every model looking flat beside its own concept art.
ambient_light_color = Color(0.34, 0.39, 0.5, 1)
ambient_light_energy = 0.32

; Dead soil from ADR-0004. The plane had no material at all and rendered as pure
; white, which blew out under the stronger sun and made every building look dark
; by comparison. The ground is 60% of the frame in this game; it cannot be a
; placeholder.
[sub_resource type="StandardMaterial3D" id="Material_ground"]
albedo_color = Color(0.545, 0.502, 0.443, 1)
roughness = 0.95

[sub_resource type="PlaneMesh" id="Mesh_ground"]
size = Vector2(60, 60)
material = SubResource("Material_ground")

[node name="AssetPreview" type="Node3D"]
script = ExtResource("1_preview")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_preview")

[node name="Camera3D" type="Camera3D" parent="."]
position = Vector3(12.247449, 10, 12.247449)
rotation_degrees = Vector3(-30, 45, 0)
projection = 1
size = 16.0
far = 200.0

[node name="Sun" type="DirectionalLight3D" parent="."]
position = Vector3(0, 20, 0)
rotation_degrees = Vector3(-45, -50, 0)
light_color = Color(1, 0.95, 0.87, 1)
light_energy = 2.0
shadow_enabled = true
directional_shadow_mode = 0

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_ground")
